    <script>
  const menuToggle = document.getElementById("menuToggle");
  if (menuToggle) {
    menuToggle.addEventListener("click", function() {
    const menu = document.getElementById("menu");
    if (menu) {
      menu.classList.add("active");
    }
  });

  }
  const closeMenu = document.getElementById("closeMenu");
  if (closeMenu) {
    closeMenu.addEventListener("click", function() {
      const menu = document.getElementById("menu");
      if (menu) {
        menu.classList.remove("active");
      }
    });
  }
  </script>
    <script>
      window.addEventListener('scroll', function() {
        var header = document.querySelector('header');
        if (header) {
          if (window.scrollY > 0) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        }
      });
    </script>

       <script>
  // 1. Idioma inicial: inglés por defecto si no hay nada guardado
  const savedLang = localStorage.getItem('lang') || 'en';
  document.documentElement.lang = savedLang;

  const langToggle = document.getElementById('lang-toggle');
  const elementosTraducibles = document.querySelectorAll('[data-es]');

  if (langToggle) {
    // 2. Inicializar botón con el idioma al que cambiará
    langToggle.dataset.lang = savedLang;
    langToggle.textContent = savedLang === 'en' ? '🇪🇸' : '🇺🇸';

    // 3. Aplicar traducción inicial según idioma guardado
    elementosTraducibles.forEach(el => {
      const text = el.dataset[savedLang];
      if (text) el.textContent = text;
    });

    // 4. Evento de cambio de idioma
    langToggle.addEventListener('click', () => {
      const currentLang = langToggle.dataset.lang || 'en';
      const newLang = currentLang === 'en' ? 'es' : 'en';

      // Cambiar textos traducibles
      elementosTraducibles.forEach(el => {
        const text = el.dataset[newLang];
        if (text) el.textContent = text;
      });

      // Actualizar botón (muestra el idioma al que cambiarás)
      langToggle.textContent = newLang === 'en' ? '🇪🇸' : '🇺🇸';
      langToggle.dataset.lang = newLang;

      // Guardar preferencia
      localStorage.setItem('lang', newLang);
      document.documentElement.lang = newLang;
    });
  }
</script>
